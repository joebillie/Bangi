{
  "name": "bangi",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "lint": "eslint .",
    "build:web": "npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write app src tests e2e *.ts *.json *.js",
    "build": "expo export --platform web && node scripts/build-pwa.mjs",
    "serve": "node scripts/serve.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "adhan": "4.4.6",
    "expo": "~54.0.38",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "geomagnetism": "^0.2.0",
    "luxon": "^3.7.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.1",
    "@types/react": "~19.1.10",
    "@types/tz-lookup": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
